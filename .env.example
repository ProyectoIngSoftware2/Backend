DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Gateway -> microservice URLs (placeholders; the defaults work for local
# development. Docker Compose overrides these with the service names).
CLIENTES_SERVICE_URL=http://localhost:8001
RESERVAS_SERVICE_URL=http://localhost:8002
CATALOGO_SERVICE_URL=http://localhost:8003
AUTH_SERVICE_URL=http://localhost:8004

# ---------------------------------------------------------------------------
# Sprint 2 - Authentication (JWT)
# ---------------------------------------------------------------------------
# JWT signing secret. REQUIRED by every service (they fail closed if it is
# missing; there is no default fallback). Generate a long random value,
# for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real secret to Git and never reuse the database password.
# IMPORTANT: leave this line EMPTY until you paste your own value. Empty
# values, values shorter than 32 characters and placeholder values (any
# REPLACE_WITH_... template) are all rejected by the services and by
# Docker Compose, so a copied example can never become a working secret.
JWT_SECRET=

# Signing algorithm (default: HS256). Must be one of the allowed
# symmetric algorithms (HS256/HS384/HS512) and the SAME value reaches
# every service so tokens verify everywhere.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default: 60).
JWT_EXPIRE_MINUTES=60

# Gateway CORS: comma-separated list of frontend origins allowed to make
# cross-origin requests, e.g. https://app.example.com,http://localhost:5173.
# Empty (default) = no CORS middleware is installed (no origin allowed).
CORS_ORIGINS=
