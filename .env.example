DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Gateway -> microservice URLs (placeholders; the defaults work for local
# development. Docker Compose overrides these with the service names).
CLIENTES_SERVICE_URL=http://localhost:8001
RESERVAS_SERVICE_URL=http://localhost:8002
CATALOGO_SERVICE_URL=http://localhost:8003
AUTH_SERVICE_URL=http://localhost:8004

# Sprint 2 Security Phase 1 (JWT settings). The shared/security.py module
# falls back to safe defaults when these are absent, so unit tests run
# without a .env file. Replace JWT_SECRET before any real deployment and
# never commit a real .env.
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
