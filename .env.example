DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Gateway -> microservice URLs (placeholders; the defaults work for local
# development. Docker Compose overrides these with the service names).
CLIENTES_SERVICE_URL=http://localhost:8001
RESERVAS_SERVICE_URL=http://localhost:8002
CATALOGO_SERVICE_URL=http://localhost:8003

# ---------------------------------------------------------------------------
# Sprint 2 - Authentication (JWT)
# ---------------------------------------------------------------------------
# JWT signing secret. REQUIRED by every service (they fail closed if it is
# missing). Generate a long random value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real secret to Git and never reuse the database password.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Access token lifetime in minutes (default: 60).
JWT_EXPIRE_MINUTES=60

# Gateway CORS: comma-separated list of frontend origins allowed to make
# cross-origin requests, e.g. https://app.example.com,http://localhost:5173.
# Empty (default) = no CORS middleware is installed (no origin allowed).
CORS_ORIGINS=
