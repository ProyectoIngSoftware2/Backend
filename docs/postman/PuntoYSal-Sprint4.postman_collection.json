    {
      "name": "1. Autenticación (API 1)",
      "description": "Login en el único proveedor de autenticación (`auth`, vía Gateway). Cada login guarda el token en la variable de colección `jwt_token`; el login de cliente además guarda `jwt_token_cliente` para los casos de prueba de RBAC (403).\n\n**Orden importa:** el último login ejecutado gana `jwt_token`. La carpeta termina con el login del administrador para que los grupos protegidos funcionen en una ejecución completa.",
      "item": [
        {
          "name": "POST /api/v1/clientes — registro público de cliente (opcional)",
          "description": "Registro público de cuenta cliente (siempre `rol='cliente'`). Útil para crear la cuenta que usará el login de cliente cuando no exista. Requiere `cliente_correo` y `cliente_password` (>= 8 caracteres).",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "application/javascript",
                "exec": [
                  "pm.test('201 creado / 409 correo duplicado / 422 datos inválidos', function () {",
                  "    pm.expect([201, 409, 422]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_completo\": \"Cliente Postman\",\n  \"correo\": \"{{cliente_correo}}\",\n  \"password\": \"{{cliente_password}}\",\n  \"telefono\": \"+504 9999-0000\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/clientes",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "clientes"]
            }
          },
          "response": []
        },
        {
          "name": "POST /api/v1/auth/login — Cliente",
          "description": "Login de cliente. Guarda el token en `jwt_token` **y** en `jwt_token_cliente`. Definir antes `cliente_correo` / `cliente_password`.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "application/javascript",
                "exec": [
                  "pm.test('Login cliente: HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Sin password ni hash en la respuesta', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.not.have.property('password');",
                  "    pm.expect(body).to.not.have.property('password_hash');",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', body.access_token);",
                  "    pm.collectionVariables.set('jwt_token_cliente', body.access_token);",
                  "    pm.test('jwt_token_cliente guardado y rol cliente', function () {",
                  "        pm.expect(body.rol).to.eql('cliente');",
                  "        pm.expect(pm.collectionVariables.get('jwt_token_cliente')).to.be.a('string').and.to.have.length.greaterThan(20);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{cliente_correo}}\",\n  \"password\": \"{{cliente_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "POST /api/v1/auth/login — Administrador",
          "description": "Login de administrador (correo sembrado en `database/sprint2_auth_seed.sql`; la contraseña vive solo en el entorno local — variable `admin_password`). Guarda el token en `jwt_token` y debe ejecutarse **último** de la carpeta.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "application/javascript",
                "exec": [
                  "pm.test('Login administrador: HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Sin password ni hash en la respuesta', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.not.have.property('password');",
                  "    pm.expect(body).to.not.have.property('password_hash');",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', body.access_token);",
                  "    pm.test('jwt_token guardado y rol administrador', function () {",
                  "        pm.expect(body.rol).to.eql('administrador');",
                  "        pm.expect(pm.collectionVariables.get('jwt_token')).to.be.a('string').and.to.have.length.greaterThan(20);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{admin_correo}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
