    {
      "name": "4. Roles (API 1 — Auth & Users)",
      "description": "Gestión de roles en el microservicio `clientes`. Lecturas públicas; creación/edición/eliminación solo admin. Incluye el endpoint nuevo `DELETE /api/v1/roles/{id}` (gap G5 del Sprint 4).",
      "item": [
        {
          "name": "GET /api/v1/roles — listado (público)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "application/javascript",
                "exec": [
                  "pm.test('HTTP 200 (público, sin token)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Al menos los roles sembrados', function () {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data).to.be.an('array');",
                  "    const nombres = data.map(function (r) { return r.nombre; });",
                  "    pm.expect(nombres).to.include.members(['administrador', 'cliente']);",
                  "});"
                ]
              }
            }
          ],
